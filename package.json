{
    "name": "wizdaphne-wiki-vue",
    "displayName": "WizDaphne Wiki Vue Frontend",
    "version": "1.0.1",
    "author": "Yuee",
    "description": "巫术达芙妮维基前端",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "run-p typecheck build-only",
        "preview": "vite preview --port 4173",
        "build-only": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
        "format": "prettier --write \"src/**/*.ts\" \"src/**/*.vue\" \"src/**/*.css\"",
        "syncyarn": "npx syncyarnlock --save --keepPrefix",
        "打包上传程序": "tsc -p tsconfig.upload.json",
        "上传到COS": "node ./local_scripts/dist/uploadToCos.js",
        "scrape:data": "tsx ./local_scripts/src/scrapeApiData.ts",
        "update:junk": "tsx ./local_scripts/src/scrapeJunkRates.ts",
        "update:equipment-bonus": "tsx ./local_scripts/src/updateEquipmentBonusRates.ts",
        "update:character-status": "tsx ./local_scripts/src/character_status_scraper.ts"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.0.17",
        "@vue-leaflet/vue-leaflet": "^0.10.1",
        "@vueuse/core": "^13.0.0",
        "dexie": "^4.0.11",
        "dompurify": "^3.2.5",
        "dotenv": "^16.4.7",
        "exceljs": "^4.4.0",
        "lodash-es": "^4.17.21",
        "pinia": "^3.0.1",
        "tailwindcss": "^4.1.0",
        "vue": "^3.5.13",
        "vue3-lazyload": "^0.3.8"
    },
    "devDependencies": {
        "@rushstack/eslint-patch": "^1.11.0",
        "@types/less": "^3.0.8",
        "@types/lodash-es": "^4",
        "@types/node": "^20.17.28",
        "@vicons/fa": "^0.13.0",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vitejs/plugin-vue-jsx": "^4.1.2",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.5.0",
        "@vue/tsconfig": "^0.7.0",
        "axios": "^1.13.2",
        "cheerio": "^1.1.2",
        "cos-nodejs-sdk-v5": "^2.14.7",
        "eslint": "^9.23.0",
        "eslint-plugin-vue": "^10.0.0",
        "huijiwiki-api": "^0.8.0",
        "less": "^4.2.2",
        "naive-ui": "^2.41.0",
        "nodemw": "^0.24.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.5.3",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.4",
        "vite-plugin-vue-devtools": "^7.7.2",
        "vue-tsc": "^2.2.8"
    },
    "packageManager": "yarn@4.12.0"
}
