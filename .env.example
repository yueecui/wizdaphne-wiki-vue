# 复制本文件为 .env 后按需填写；.env 已被 .gitignore 忽略。
# 前端（vite）与本地脚本（tsx / python）读的都是这一份。

# ── 站点 ────────────────────────────────────────────────────────
# huijiwiki 子域名前缀，即 https://<前缀>.huijiwiki.com
VITE_WIKI_PREFIX=wizdaphne

# ── 上传到 wiki（[UPDATE 3] / [WIKI] haken / 角色故事）──────────────
# 在 wiki 的浏览器控制台中执行下面的 js 获取第三方验证用 token：
# fetch('/api.php?action=session_verification&format=json').then((res)=>res.json()).then((data)=>console.log(data.session_verification.token))
WIKI_USERNAME=
WIKI_PASSWORD=
WIKI_AUTHKEY=

# [UPDATE 3] 上传到 wiki 的增量上传缓存（sqlite），留空 = local_scripts/work/wikitext.sqlite
WIKI_CACHE_SQLITE_PATH=

WIKI_JS_IMPORTER_PAGE_TITLE=零件:WikiImporter.js
WIKI_GADGET_JS_PAGE_TITLE=
WIKI_GADGET_CSS_PAGE_TITLE=

# ── 上传到 COS ──────────────────────────────────────────────────
COS_SECRET_ID=
COS_SECRET_KEY=
# 桶名与区域（腾讯云控制台可查）
COS_BUCKET=
COS_REGION=
# 桶内路径前缀，形如 <你的目录>/<项目名>
COS_PATH_PREFIX=

# ── 解包工程（数据更新时才需要）──────────────────────────────────
# 解包仓库根目录。留空 = 与本仓库同级的 WizardyDaphneUnpack
WIZDAPHNE_UNPACK=
# 只指向主数据表目录时用（优先于 WIZDAPHNE_UNPACK）
# WIZDAPHNE_MASTERDATA=
# 营地 / 酒馆话题摘要目录，留空 = <WIZDAPHNE_UNPACK>/out/topic_digest
# WIZDAPHNE_TOPIC_DIGEST=
# 清洗中间产物目录，留空 = local_scripts/work/clean（diff_data.py 比对时可改）
# WIZDAPHNE_CLEAN=

# ── 前端本地开发 ────────────────────────────────────────────────
VITE_PORT=8765
VITE_IS_LOCAL=
VITE_LOCAL_MEMBER_API_URL=
# 在wiki的浏览器控制台中执行下面的js获取wiki第三方验证用token
# fetch('/api.php?action=session_verification&format=json').then((res)=>res.json()).then((data)=>console.log(data.session_verification.token))
VITE_DEV_TOKEN=
